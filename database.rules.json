{
  "rules": {
    ".read": false,
    ".write": false,

    "badges": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2'"
    },
    "streaks": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "plugins_verified": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())"
    },
    "plugins_filters": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())"
    },
    "plugins_blocked": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())"
    },
    "moderators": {
      ".read": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2'"
    },
    "mod_notify": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isBoolean()"
      }
    },
    "plugins_pending": {
      ".read": true,
      "$pluginId": {
        ".write": true,
        ".validate": "newData.hasChildren(['id','name','version','author','source','submitterId','submittedAt']) && newData.child('id').val() === $pluginId && newData.child('submitterId').isNumber() && newData.child('submittedAt').isNumber() && newData.child('source').isString() && newData.child('source').val().length <= 1048576"
      }
    },
    "plugins_catalog": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())"
    },
    "plugins_rejected": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())"
    },
    "plugin_reviews": {
      ".read": true,
      "$pluginId": {
        "$userId": {
          ".write": true,
          ".validate": "newData.hasChildren(['userId','rating','text','date']) && newData.child('userId').isNumber() && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && newData.child('text').isString() && newData.child('text').val().length <= 2000 && newData.child('date').isNumber() && newData.child('date').val() <= now"
        }
      }
    },
    "plugin_review_reports": {
      ".read": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())",
      "$reportId": {
        ".write": true,
        ".validate": "newData.hasChildren(['pluginId','reviewUserId','reporterId','reason','date']) && newData.child('reason').isString() && newData.child('reason').val().length <= 500 && newData.child('date').isNumber() && newData.child('date').val() <= now"
      }
    },
    "plugin_reports": {
      ".read": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())",
      "$reportId": {
        ".write": true,
        ".validate": "newData.hasChildren(['pluginId','reporterId','reason','date']) && newData.child('reason').isString() && newData.child('reason').val().length <= 500 && newData.child('date').isNumber() && newData.child('date').val() <= now"
      }
    },
    "plugin_history": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())"
    },
    "plugin_backups": {
      ".read": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())",
      ".write": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())"
    },
    "plugins_hidden": {
      ".read": true,
      ".write": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())"
    },
    "analytics": {
      ".read": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())",
      ".write": true
    },
    "crashes": {
      ".read": "auth != null && (auth.uid === 'cZUBpCEJWVNAZEuChkG52gdgs0K2' || root.child('moderators').child(auth.uid).exists())",
      ".write": true
    }
  }
}
